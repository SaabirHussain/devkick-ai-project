# Copy to backend/.env (or export in your shell). Never commit real keys.
KEV_DEMO_KEY=your-kev-demo-key-here

# Optional overrides
KEV_BASE_URL=https://yohann-60613--kev-demo.modal.run
KEV_MODEL=kev-9b
# Seconds; the first call after idle can take 3-4 minutes while Kev wakes a GPU.
KEV_TIMEOUT_SECONDS=300
# Predictions below this confidence (0-1) are sent to human review.
CONFIDENCE_THRESHOLD=0.8
